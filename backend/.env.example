# Project Configuration
PROJECT_NAME="RAG-Based College Information Chatbot"
SECRET_KEY="college-chatbot-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (SQLite by default, switchable to PostgreSQL)
DATABASE_URL="sqlite:///./college_bot.db"
# Example PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/college_bot"

# ChromaDB Settings
CHROMA_PERSIST_DIRECTORY="./chroma_db"
COLLECTION_NAME="college_documents"

# RAG & Embeddings
# (Optional) Add your OpenAI API key or Google Gemini API key below to enable external LLM reasoning.
# If left blank, the app will automatically use the built-in local retrieval and grounded synthesizer!
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# RAG Hyperparameters
TOP_K_CHUNKS=4
SIMILARITY_THRESHOLD=0.25
CHUNK_SIZE=650
CHUNK_OVERLAP=100
